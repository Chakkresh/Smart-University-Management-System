        <script><![CDATA[function onSubmit() {
    var fromDate = g_form.getValue('from_date'); // replace with your field name
    
    if (fromDate) {
        var selectedDate = new Date(fromDate);
        var today = new Date();
        today.setHours(0, 0, 0, 0); // strip time for date-only comparison
        
        if (selectedDate < today) {
            g_form.showFieldMsg('from_date', 'From Date cannot be in the past', 'error');
            g_form.setValidationError(true);
            return false;
        }
    }
    return true;
}]]></script>
